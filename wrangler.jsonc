{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byeoldori-web",
  "main": ".open-next/worker.js",
  // nodejs_compat 필수 + 2024-09-23 이상이어야 한다 (@opennextjs/cloudflare 요구사항)
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 커스텀 도메인 — CF가 DNS 레코드와 인증서를 자동 생성한다.
  // apex를 canonical로 두고 www는 앱에서 리다이렉트한다.
  "routes": [
    { "pattern": "byeoldori.com", "custom_domain": true },
    { "pattern": "www.byeoldori.com", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "byeoldori-web"
    }
  ],
  "observability": {
    "enabled": true
  }
}
