# Byeoldori Web - 환경변수 예시
# 이 파일을 .env.local로 복사하여 사용하세요

# 백엔드 API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# 네이버 지도 Client ID (https://www.ncloud.com/product/applicationService/maps)
NEXT_PUBLIC_NAVER_CLIENT_ID=your_naver_client_id

# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# 카카오 OAuth Client ID (developers.kakao.com)
NEXT_PUBLIC_KAKAO_CLIENT_ID=your_kakao_client_id

# 네이버 OAuth Client ID (developers.naver.com) — 지도 API와 별도
NEXT_PUBLIC_NAVER_OAUTH_CLIENT_ID=your_naver_oauth_client_id
